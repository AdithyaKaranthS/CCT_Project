rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRecord() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read, delete: if ownsRecord();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId == productId
        && request.resource.data.get('invoiceURL', null) == null
        && request.resource.data.get('invoiceStoragePath', null) == null;
      allow update: if ownsRecord()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId == productId
        && request.resource.data.get('invoiceURL', null) == resource.data.get('invoiceURL', null)
        && request.resource.data.get('invoiceStoragePath', null) == resource.data.get('invoiceStoragePath', null);
    }

    match /serviceRecords/{serviceId} {
      allow read, delete: if ownsRecord();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsRecord() && request.resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if ownsRecord();
      allow write: if false;
    }
  }
}
