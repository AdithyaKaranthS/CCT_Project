FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional for local service-account credentials; prefer Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
ALLOWED_ORIGINS=http://localhost:5173,https://your-project-id.web.app
SCHEDULER_SECRET=replace-with-a-long-random-secret
# Optional. Defaults to %LOCALAPPDATA%\Warrantly\invoices on Windows.
# LOCAL_INVOICE_STORAGE_DIR=C:\Users\YourName\AppData\Local\Warrantly\invoices

# Optional SMTP delivery for scheduled expiry notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
